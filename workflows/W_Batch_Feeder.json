    {
      "parameters": {
        "jsCode": "// Build everything the feeder needs from config in one item:\n//   aborted     — cooperative kill-switch (same protocol as W3 Dispatch Check Abort)\n//   q           — Drive files.list query for the Batch/ folder\n//   batch_folder / input_folder — folder IDs for the move\n//   slack_channel — for batch-level notifications\nconst cfg = {};\n$('Read Config').all().forEach(i => { if (i.json && i.json.key) cfg[i.json.key] = i.json.value; });\nconst batch_folder = (cfg.drive_batch_folder_id || '').toString().trim();\nconst input_folder = (cfg.drive_input_folder_id || '').toString().trim();\nif (!batch_folder) throw new Error('drive_batch_folder_id is not set in config');\nif (!input_folder) throw new Error('drive_input_folder_id is not set in config');\nconst runToken = (cfg.localization_run_token || '').toString().trim();\nconst abortToken = (cfg.localization_abort_token || '').toString().trim();\nconst aborted = !!(runToken && abortToken && abortToken === runToken);\nconst q = \"'\" + batch_folder + \"' in parents and trashed = false and mimeType != 'application/vnd.google-apps.folder'\";\nreturn [{ json: { aborted, q, batch_folder, input_folder, slack_channel: cfg.slack_channel || '' } }];"
      },
