    {
      "parameters": {
        "jsCode": "// Pick the first (name-sorted) file from Batch/ and derive its lesson_id with the EXACT\n// Parse Filename logic. Emit has_next=false when the folder is empty (batch finished).\nconst files = ($json.files) || [];\nconst derive = (filename) => {\n  const baseName = (filename || '').replace(/\\.[^./\\\\]+$/, '');\n  return baseName.trim().toLowerCase().replace(/[^a-z0-9_-]+/g, '_').replace(/^_+|_+$/g, '');\n};\nconst prep = $('Prep').first().json;\nif (files.length === 0) {\n  return [{ json: { has_next: false, batch_folder: prep.batch_folder, input_folder: prep.input_folder, slack_channel: prep.slack_channel } }];\n}\nconst sorted = files.slice().sort((a, b) => (a.name || '').localeCompare(b.name || ''));\nconst f = sorted[0];\nreturn [{ json: { has_next: true, id: f.id, name: f.name, mimeType: f.mimeType, lesson_id: derive(f.name), batch_folder: prep.batch_folder, input_folder: prep.input_folder, slack_channel: prep.slack_channel, remaining: sorted.length } }];"
      },
