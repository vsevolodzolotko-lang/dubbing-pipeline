# ─── Dubbing Studio config ───────────────────────────────────────────────
# Copy to `.env` and fill in. With NO Google credentials the app boots in
# MOCK mode (fixtures, zero contact with live Google APIs) — safe to run while
# the pipeline is active.

# Server
PORT=8787
HOST=127.0.0.1

# Mode: leave blank to auto-detect (mock when no creds), or force "mock" / "live"
MODE=

# ─── Google access ───────────────────────────────────────────────────────
# The spreadsheet the pipeline uses (config/segments/voices/localizations/prompts)
SHEET_ID=

# Auth mode: "sa" (service account, recommended) or "oauth"
GOOGLE_AUTH_MODE=sa

# Service account: path to JSON key OR base64-encoded JSON blob (for the server)
GOOGLE_SA_KEY_PATH=./secrets/service-account.json
# GOOGLE_SA_KEY_JSON=

# OAuth fallback (only when GOOGLE_AUTH_MODE=oauth)
# GOOGLE_OAUTH_CLIENT_PATH=./secrets/oauth-client.json
# GOOGLE_OAUTH_TOKEN_PATH=./secrets/oauth-token.json

# ─── Safety flags ────────────────────────────────────────────────────────
# Write actions (regen / stop / accept-reject) stay OFF until you flip this.
# Reads are always allowed. Keep "false" while validating against the live sheet.
ENABLE_WRITES=false

# ─── Cache ───────────────────────────────────────────────────────────────
CACHE_DIR=./cache
AUDIO_CACHE_MAX_GB=5
